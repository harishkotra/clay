{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["server-node/**/*.ts", "shared/**/*.ts", "agent/inference.ts", "agent/components.ts", "agent/prompt.ts", "agent/turn.ts", "scripts/**/*.mjs"]
}
