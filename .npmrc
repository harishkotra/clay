# `agents@0.24.0` declares an OPTIONAL peer on react@^19 (only used by the
# `agents/react` subpath, which Clay does not import — the client is React 18 by
# design). npm's ERESOLVE refuses to install anyway, so peer resolution is
# relaxed here and the real peers the runtime needs (@modelcontextprotocol/*,
# zod) are declared explicitly in package.json.
legacy-peer-deps=true
